<refentry id="secretctl">

  <refentryinfo>
    <title>secretctl</title>
    <productname>platformd</productname>
  </refentryinfo>

  <refmeta>
    <refentrytitle>secretctl</refentrytitle>
    <manvolnum>1</manvolnum>
    <refmiscinfo class="source">platformd</refmiscinfo>
    <refmiscinfo class="manual">platformd-secretd</refmiscinfo>
  </refmeta>

  <refnamediv>
    <refname>secretctl</refname>
    <refpurpose>Inspect and control platformd-secretd</refpurpose>
  </refnamediv>

  <refsynopsisdiv>
    <cmdsynopsis>
      <command>secretctl</command>
      <arg choice="req">COMMAND</arg>
    </cmdsynopsis>
  </refsynopsisdiv>

  <refsect1>
    <title>Description</title>

    <para><command>secretctl</command> inspects and controls
    <citerefentry><refentrytitle>platformd-secretd.service</refentrytitle><manvolnum>8</manvolnum></citerefentry>.
    Use
    <citerefentry project='man-pages'><refentrytitle>secret-tool</refentrytitle><manvolnum>1</manvolnum></citerefentry>
    or another Secret Service client to store and retrieve individual
    secrets.</para>
  </refsect1>

  <refsect1>
    <title>Commands</title>

    <variablelist>
      <varlistentry>
        <term><command>status</command></term>
        <listitem>
          <para>Show the owner of
          <constant>org.freedesktop.secrets</constant>, the current logind
          session and lock hint, and the identity evidence available for the
          calling process. This command does not activate a provider or read a
          stored secret.</para>
        </listitem>
      </varlistentry>

      <varlistentry>
        <term><command>list</command></term>
        <listitem>
          <para>List labels and attributes for items in the default collection.
          Secret values are not returned.</para>
        </listitem>
      </varlistentry>

      <varlistentry>
        <term><command>lock</command></term>
        <listitem>
          <para>Set the manual lock state of the default collection.</para>
        </listitem>
      </varlistentry>

      <varlistentry>
        <term><command>unlock</command></term>
        <listitem>
          <para>Clear the manual lock state of the default collection. When
          authorization is required, wait for the Secret Service Prompt to
          complete. Unlock is refused while the tracked logind session is
          locked.</para>
        </listitem>
      </varlistentry>

      <varlistentry>
        <term><command>version</command></term>
        <listitem><para>Print the program version.</para></listitem>
      </varlistentry>

      <varlistentry>
        <term><command>help</command></term>
        <listitem><para>Print a short help text.</para></listitem>
      </varlistentry>
    </variablelist>
  </refsect1>

  <refsect1>
    <title>Exit status</title>

    <para>On success, 0 is returned. Otherwise, a non-zero failure code is
    returned.</para>
  </refsect1>

  <refsect1>
    <title>See Also</title>

