# platformd-secretd administrative / introspection interface.
#
# Read-only service status and item metadata.
interface io.platformd.Secret

method GetStatus() -> (
        locked: bool,
        desktopLocked: bool,
        manualLocked: bool,
        itemCount: int,
        encrypted: bool,
        sessionTracked: string,
        homeStorage: string
)

type Item (
        label: string,
        attributes: [string]string,
        created: int,
        modified: int
)

# Secret values are not returned.
method ListItems() -> (items: []Item)
